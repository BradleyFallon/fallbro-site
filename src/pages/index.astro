---
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import WritingCard from "@/components/WritingCard.astro"
import Layout from "@/layouts/Layout.astro"
import { getWriting } from "@/lib/content"
import { withBase } from "@/lib/utils"
import { getCollection } from "astro:content"

const projects = (await getCollection("projects"))
  .filter(({ data }) => data.featured)
  .sort(
    (a, b) =>
      (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
  )
const writing = (await getWriting()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" />
  <hero-block>
    <p data-kicker>Bradley Fallon</p>
    <h1>Software, experiments, writing, and strange useful things.</h1>
    <p>
      I’m a software engineer and creative technologist. FALLBRO is where I
      collect practical tools, technical investigations, and small ideas worth
      making real.
    </p>
  </hero-block>

  <home-banner>
    <img
      src={withBase("/og.png")}
      alt=""
      width="1200"
      height="630"
      decoding="async"
      fetchpriority="high"
    >
  </home-banner>

  <section>
    <section-heading>
      <h2>Selected work</h2>
      <a href={withBase("/projects")}>All projects →</a>
    </section-heading>
    <ul>
      {projects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </section>

  <section>
    <section-heading>
      <h2>Writing</h2>
      <a href={withBase("/writing")}>Writing archive →</a>
    </section-heading>
    {writing.length > 0 ? (
      <ul>{writing.map((entry) => <WritingCard entry={entry} />)}</ul>
    ) : (
      <p data-empty>
        Longer notes are being edited. The unfinished drafts stay private until
        they are ready.
      </p>
    )}
  </section>

  <section>
    <section-heading>
      <h2>Toys</h2>
      <a href={withBase("/toys")}>Visit the toy shelf →</a>
    </section-heading>
    <toy-teaser>
      <a href={withBase("/toys/8glyph")}>8glyph</a>
      <p>An 8×8 glyph maker built from two color masks and transparency.</p>
      <span>In development</span>
    </toy-teaser>
  </section>
</Layout>

<style>
  hero-block,
  home-banner,
  section,
  section-heading,
  toy-teaser {
    display: block;
  }

  hero-block {
    max-width: 44rem;
    padding-block: var(--space-s) var(--space-l);

    [data-kicker] {
      margin-block-end: var(--space-xs);
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    h1 {
      max-width: 17ch;
      font-size: var(--step-4);
      line-height: 1.05;
      font-weight: var(--font-weight-medium);
      text-wrap: balance;
    }

    > p:last-child {
      max-width: 58ch;
      margin-block-start: var(--space-s);
      color: var(--muted-foreground);
      font-size: var(--step-1);
    }
  }

  home-banner {
    overflow: hidden;
    background: #001219;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  section {
    margin-block-start: var(--space-xl);

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }
  }

  section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
    padding-block-end: var(--space-2xs);
    border-block-end: 1px solid var(--border);

    h2 {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
    }

    a {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  [data-empty],
  toy-teaser p {
    color: var(--muted-foreground);
  }

  toy-teaser {
    position: relative;
    padding: var(--space-s);
    background: color-mix(in oklab, var(--accent-soft) 55%, var(--background));
    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    > a {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
    }

    span {
      display: inline-block;
      margin-block-start: var(--space-xs);
      font-size: var(--step--1);
      color: var(--accent-warm);
    }
  }
</style>
